# ═══════════════════════════════════════════════════════════════
# TaxSaathi — Root Environment Example
# Copy to .env and fill in real values.
# ═══════════════════════════════════════════════════════════════

# ── Backend ──────────────────────────────────────────────────
# App mode: development enables /docs, SQLite fallback, CORS for localhost:5173
ENV=development

# JWT secret — MUST be set before starting the backend.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_secure_random_secret

# Google Gemini API key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model ids. Leave unset to use the defaults in backend/config.py.
# Both default to gemini-3.8-flash. gemini-2.0-flash is retired.
GEMINI_MODEL_EXTRACT=gemini-3.8-flash
GEMINI_MODEL_ADVISORY=gemini-3.8-flash

# Absolute Chroma directory. Leave blank to use backend/data/chroma_db.
CHROMA_PATH=

# Database URL — leave blank to use SQLite at data/app.db
# PostgreSQL example: postgresql://user:pass@host:5432/taxsaathi
DATABASE_URL=

# Extra CORS origins (comma-separated) beyond localhost:5173 and production Vercel URL
CORS_ALLOWED_ORIGINS=

# ── Frontend (prefix all with VITE_) ─────────────────────────
# Vite reads these from frontend/.env
VITE_API_URL=http://localhost:8000

