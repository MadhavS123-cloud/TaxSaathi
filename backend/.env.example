# TaxSaathi Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# ⚠️  NEVER commit .env — it is in .gitignore.

# ── Environment mode ───────────────────────────────────────────────────────────
# Set to "development" locally to enable /docs, SQLite fallback, and dev CORS origins.
# Leave as "production" (or omit) on Render.
ENV=production

# ── JWT (Phase 2) ─────────────────────────────────────────────────────────────
# Secret used to sign and verify HS256 JWTs issued by POST /auth/google.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 characters. Backend refuses to start in production without it.
# Even in development, an empty JWT_SECRET causes require_jwt_user to reject
# all requests with HTTP 500.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# ── Google OAuth (Phase 2) ────────────────────────────────────────────────────
# Client ID from Google Cloud Console → APIs & Services → Credentials.
# Used to verify the audience claim of the Google ID token locally.
# GOOGLE_CLIENT_SECRET is NOT needed — ID token verification is offline.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# ── Allowed emails ────────────────────────────────────────────────────────────
# Comma-separated list of Google account emails permitted to log in.
# Emails are lowercased and stripped before comparison.
# An empty value blocks ALL logins (backend warns on startup in dev,
# exits in production).
# Example: ALLOWED_EMAILS=alice@example.com,bob@example.com
ALLOWED_EMAILS=

# ── Database ──────────────────────────────────────────────────────────────────
# Use the Supabase Session Pooler (IPv4-compatible, free on all plans).
# Get this string from: Supabase Dashboard → Settings → Database → Session Pooler
# Format: postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Model ids. Defaults live in config.py if these are omitted.
# Both default to gemini-3.8-flash. gemini-2.0-flash is retired.
GEMINI_MODEL_EXTRACT=gemini-3.8-flash
GEMINI_MODEL_ADVISORY=gemini-3.8-flash

# Absolute path to the Chroma store. Blank uses backend/data/chroma_db.
CHROMA_PATH=

# ── Gnani speech (Prisma STT, Timbre TTS) ────────────────────────────────────
# Dashboard key. Sent as X-API-Key-ID. Never commit the real value.
GNANI_API_KEY=YOUR_GNANI_API_KEY

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of additional allowed frontend origins beyond the default
# (https://tax-saathi-gamma.vercel.app). http://localhost:5173 is added automatically
# when ENV=development.
# Example: CORS_ALLOWED_ORIGINS=https://staging.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# ── Alembic / DB migrations ───────────────────────────────────────────────────
# Run before starting the server on Render (pre-deploy command):
#   cd backend && alembic upgrade head
# Locally (with venv activated):
#   alembic upgrade head
