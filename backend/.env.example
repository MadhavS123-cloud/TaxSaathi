# TaxSaathi Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# ⚠️  NEVER commit .env — it is in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
# Use the Supabase Session Pooler (IPv4-compatible, free on all plans).
# Get this string from: Supabase Dashboard → Settings → Database → Session Pooler
# Format: postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Your deployed frontend URL — added to the CORS allow-list automatically.
FRONTEND_URL=https://your-frontend.vercel.app
